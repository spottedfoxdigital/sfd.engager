# ---------------------------------------------------------------------------
# SFD Engager — environment variables
# Copy this file to `.env` and fill in the values for local development.
# On Railway, set these in the service's Variables tab.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Railway provides this automatically when you add a Postgres plugin (DATABASE_URL).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sfd_engager?schema=public"

# ---------------------------------------------------------------------------
# Auth (simple shared-password login for the small team — same access for all)
# ---------------------------------------------------------------------------
# The password your team types on the login screen.
APP_PASSWORD="change-me"
# A long random string used to sign the session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Anthropic / Claude — used for spam+sentiment classification and drafting.
# If unset, the app falls back to built-in heuristics so the mock slice still
# runs end-to-end (with lower-quality drafts/classification).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Model used for high-volume spam/sentiment classification (cheap + fast).
CLASSIFY_MODEL="claude-haiku-4-5"
# Model used for drafting comment replies and DMs in the client's voice.
DRAFT_MODEL="claude-sonnet-4-6"

# ---------------------------------------------------------------------------
# Meta (Facebook / Instagram) integration.
# Leave PROVIDER=mock until your Meta Developer App + App Review are ready.
# Flip to PROVIDER=meta to use the live Graph API.
# ---------------------------------------------------------------------------
META_PROVIDER="mock"
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
# Facebook Login for Business: the Configuration ID that defines which
# permissions/assets are requested (created in the Meta app → Facebook Login
# for Business → Configurations). Required for the live connect flow.
META_LOGIN_CONFIG_ID=""
